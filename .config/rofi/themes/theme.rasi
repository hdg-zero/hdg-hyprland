* {
    bg-col: #0e2537;        /* Darker background color */
    bg-col-light: #cce7e0;  /* Lighter background color */
    selected-col: #65827e;  /* Muted teal color */
    blue: #7eb1dd;          /* Kept as is, consider changing if needed */
    fg-col: #cce7e0;        /* Lighter foreground color */
    teal: #65827e;          /* Muted teal color */
    white: #FFFFFF;         /* Kept as is */

    width: 450;
    border-radius: 15px;
}

element-text, element-icon, mode-switcher {
    background-color: inherit;
    text-color: inherit;
}

window {
    height: 360px;
    border: 2px;
    border-color: @teal;
    background-color: @bg-col;
}

mainbox, inputbar, listview, element, entry, textbox, message {
    background-color: @bg-col;
}

inputbar {
    children: [prompt, entry];
    border-radius: 5px;
    padding: 2px;
}

prompt {
    background-color: @bg-col;
    padding: 6px;
    text-color: @fg-col;
    border-radius: 100px;
    margin: 20px 0px 0px 0px;
}

textbox-prompt-colon {
    expand: false;
    str: ":";
}

element {
    padding: 6px;
    text-color: @fg-col;
}

entry {
    margin: 20px 0px 0px 10px;
    padding: 6px;
    text-color: @white;
}

listview {
    border: 0px;
    padding: 6px 0px 0px;
    margin: 10px 50px 0px 50px;
    columns: 1;
    lines: 6;
}

element-icon {
    size: 1.3em;
}

element selected {
    background-color: @selected-col;
    text-color: @white;
}

mode-switcher {
    spacing: 0;
}

button {
    padding: 10px;
    background-color: @bg-col-light;
    text-color: @fg-col;
    vertical-align: 0.5;
    horizontal-align: 0.5;
}

button selected {
    background-color: @bg-col;
    text-color: @white;
}

message {
    margin: 2px;
    padding: 2px;
    border-radius: 5px;
}

textbox {
    margin: 20px 0px 0px 20px;
    text-color: @blue;
    background-color: @bg-col-light;
}