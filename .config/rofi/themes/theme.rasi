* {
    bg-col: rgba(11, 15, 20, 0.85);        /* Glassmorphic Obsidian */
    bg-col-light: rgba(24, 49, 66, 0.8);  /* Subtle dark blue detail */
    selected-col: #5dade2;                 /* Glacier Blue highlight */
    blue: #5dade2;
    fg-col: #f8fafc;                       /* Off-white ice-blue text */
    fg-col-muted: #64748b;                 /* Muted Slate text */
    border-col: rgba(93, 173, 226, 0.35);  /* Glacier blue glass border */
    white: #FFFFFF;

    width: 33%;                            /* Take exactly 1/3 of the screen width */
    border-radius: 12px;
}

element-text, element-icon {
    background-color: transparent;
}

window {
    border: 1px;
    border-color: @border-col;
    background-color: @bg-col;
    border-radius: 20px;
    padding: 20px 20px 0px 20px; /* Reduced bottom padding */
}

mainbox {
    background-color: transparent;
    padding: 10px 10px 0px 10px; /* Reduced bottom padding */
}

inputbar {
    children: [prompt, entry];
    background-color: rgba(255, 255, 255, 0.05); /* Very faint glass input */
    border-radius: 10px;
    padding: 10px 14px;
    margin: 0 0 20px 0;
}

prompt {
    background-color: transparent;
    padding: 0 8px 0 0;
    text-color: @selected-col;
}

entry {
    background-color: transparent;
    text-color: @fg-col;
}

listview {
    border: 0px;
    padding: 0px;
    margin: 0px;
    columns: 5;          /* 5 columns grid layout */
    lines: 2;            /* 2 rows */
    background-color: transparent;
    fixed-height: false;
    spacing: 15px;       /* Spacing between grid cells */
}

element {
    orientation: vertical;      /* Stack icon on top of text */
    padding: 15px 10px;
    background-color: transparent;
    border-radius: 12px;
    spacing: 8px;               /* Space between icon and text */
}

element-icon {
    size: 48px;                 /* Larger icons */
    horizontal-align: 0.5;
    vertical-align: 0.5;
    background-color: transparent;
}

element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;
    text-color: transparent;    /* Invisible by default */
    background-color: transparent;
}

element selected {
    background-color: rgba(255, 255, 255, 0.05); /* Faint highlight on selection */
    text-color: @selected-col;
}

/* Make text visible when selected */
element-text selected {
    text-color: @fg-col;
}

mode-switcher {
    spacing: 0;
    background-color: transparent;
}

button {
    padding: 10px;
    background-color: transparent;
    text-color: @fg-col-muted;
    vertical-align: 0.5;
    horizontal-align: 0.5;
}

button selected {
    background-color: transparent;
    text-color: @selected-col;
}

message {
    margin: 10px 0 0 0;
    padding: 10px;
    border-radius: 8px;
    border: 1px;
    border-color: rgba(231, 76, 60, 0.3); /* Faint red warning border */
    background-color: rgba(255, 255, 255, 0.02);
}

textbox {
    text-color: #e74c3c;
    background-color: transparent;
}