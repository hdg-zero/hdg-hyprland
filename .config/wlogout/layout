{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "Éteindre",
    "keybind" : "s"
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "Redémarrer",
    "keybind" : "r"
}
{
    "label" : "suspend",
    "action" : "loginctl lock-session && systemctl suspend",
    "text" : "Veiller",
    "keybind" : "u"
}
{
    "label" : "hibernate",
    "action" : "systemctl hibernate",
    "text" : "Hiberner",
    "keybind" : "h"
}
{
    "label" : "lock",
    "action" : "hyprlock",
    "text" : "Verrouiller",
    "keybind" : "l"
}
{
    "label" : "logout",
    "action" : "uwsm stop",
    "text" : "Se déconnecter",
    "keybind" : "e"
}