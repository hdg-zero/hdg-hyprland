{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-width": 420,
  "control-center-height": 600,
  "control-center-margin-top": 8,
  "control-center-margin-bottom": 8,
  "control-center-margin-right": 8,
  "control-center-margin-left": 8,
  "notification-window-width": 400,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "fit-to-screen": true,
  "relative-timestamps": true,
  "timeout": 8,
  "timeout-low": 4,
  "timeout-critical": 0,
  "widgets": [
    "label#header",
    "buttons-grid#toggles",
    "mpris",
    "volume",
    "backlight",
    "inhibitors",
    "title",
    "notifications"
  ],
  "widget-config": {
    "label#header": {
      "text": "                    󰣇 ",
      "max-lines": 1
    },
    "label#separator": {
      "text": " "
    },
    "label#separator2": {
      "text": " "
    },
    "label#controls": {
      "text":"",
      "max-lines": 1
    },
    "dnd": {
      "text": "Ne pas déranger"
    },
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Effacer"
    },
    "inhibitors": {
      "text": "Inhibiteurs",
      "button-text": "Fermer",
      "clear-all-button": true
    },
    "mpris": {
      "image-size": 80,
      "image-radius": 12,
      "blur": true,
      "ignored-players": ["playerctld"]
    },
    "volume": {
      "label": "󰕾",
      "show-per-app": true,
      "show-per-app-icon": true,
      "show-per-app-label": true,
      "empty-list-label": "Aucune application audio",
      "expand-button-label": " ",
      "collapse-button-label": " "
    },
    "backlight": {
      "label": "󰃠"
    },
    "buttons-grid#toggles": {
      "buttons-per-row": 3,
      "actions": [
        {
          "label": "󰖩",
          "type": "toggle",
          "active": true,
          "command": "sh -c '[ \"$SWAYNC_TOGGLE_STATE\" = \"true\" ] && nmcli radio wifi on || nmcli radio wifi off'",
          "update-command": "sh -c '[ \"$(nmcli radio wifi)\" = \"enabled\" ] && echo true || echo false'"
        },
        {
          "label": "󰂯",
          "type": "toggle",
          "active": true,
          "command": "sh -c '[ \"$SWAYNC_TOGGLE_STATE\" = \"true\" ] && bluetoothctl power on || bluetoothctl power off'",
          "update-command": "sh -c 'bluetoothctl show | grep -q \"Powered: yes\" && echo true || echo false'"
        },
        {
          "label": "󰍬",
          "type": "toggle",
          "command": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
          "update-command": "sh -c 'wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED && echo true || echo false'"
        },
        {
          "label": "󰖁",
          "type": "toggle",
          "command": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
          "update-command": "sh -c 'wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q MUTED && echo true || echo false'"
        },
        {
          "label": "󰌾",
          "command": "hyprlock"
        },
        {
          "label": "󰐥",
          "command": "systemctl poweroff"
        }
      ]
    }
  }
}